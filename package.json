{
  "name": "amader-khamar-dynamic",
  "version": "1.3.0",
  "private": true,
  "description": "Original v1.2 Bengali farm UI with Neon PostgreSQL persistence on Vercel",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:init": "node scripts/init.mjs",
    "init": "node scripts/init.mjs",
    "db:migrate:sqlite": "node scripts/migrate-sqlite.mjs",
    "add-user": "node scripts/add-user.mjs",
