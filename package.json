    "test:integration": "node --test tests/postgres-integration.test.mjs",
    "db:check": "node scripts/check-db.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
