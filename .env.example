# SQLite database persisted on server disk (use an absolute path in production)
DATABASE_PATH=./data/farm.sqlite
# Required only for creating or resetting the initial admin user through npm run init
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_UNIQUE_PASSWORD
# Optional: change the display name without altering farm records
FARM_NAME=আমাদের খামার
