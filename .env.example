# Copy this file to .env.local and supply your OWN Neon pooled connection string.
# Never commit .env.local or embed credentials in frontend code.
# Neon dashboard -> Connect -> Pooled connection (host contains -pooler).
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_NEON_POOLER_HOST.neon.tech/neondb?sslmode=require
# For first-time local `npm run db:init` only. Do not set ADMIN_PASSWORD on Vercel.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_UNIQUE_PASSWORD
FARM_NAME=আমাদের খামার
